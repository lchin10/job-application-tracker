# Copy to .env.local and fill in. Settings -> API in your Supabase project.
# The anon key is safe to ship in the frontend ONLY because Row Level Security is enabled.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only (scripts/qa_backfill.ts). No VITE_ prefix, so Vite never bundles it.
ANTHROPIC_API_KEY=your-anthropic-api-key
